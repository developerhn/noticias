{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noticias",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "hn-argentina",
    "database_id": "9294fb4d-600f-48c1-9fc1-09b2e2a75301",
    "migrations_dir": "migrations"
  }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "079db4d33dd343bfad6baeab8a30b8fe" }]
}
